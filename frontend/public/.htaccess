# ---- malformed slugs from raw editor input (Apache decodes %20 to a space) ----
RewriteRule "^2026/06/13/Wedding Stage Designs for Modern Couples/?$" /blog/wedding-stage-designs-for-modern-couples [R=301,NC,L]
RewriteRule "^2026/04/15/wedding decorator packages nj,.*$" /blog/wedding-decor-packages-new-jersey-cost-style-guide [R=301,NC,L]
RewriteRule ^blog/2026-Wedding-Decor-Trends/?$ /blog/2026-wedding-decor-trends [R=301,L]

# ---------------------------------------------------------------------------
# 6. FORMER 410s — all four have live replacements in sitemap.xml
# ---------------------------------------------------------------------------
RewriteRule ^2025/01/11/10-creative-ideas-for-cocktail-table-wedding-decorations-that-wow/?$ /blog/10-creative-ideas-for-cocktail-table-wedding-decorations-that-wow [R=301,L]
RewriteRule ^2025/05/05/bridal-shower-decorations-trends/?$ /blog/bridal-shower-decorations-trends [R=301,L]
# /2025/07/20/olive-green-wedding-decor-ideas — NO RULE. It is a live canonical
# post (in sitemap.xml) and must fall through to the prerender/SPA handlers.
# It previously carried a 410, which was deindexing a live article.
RewriteRule ^2025/08/07/emerald-green-wedding-decor-is-taking-over-2025/?$ /blog/emerald-green-wedding-decor-is-taking-over-2025 [R=301,L]
RewriteRule ^2025/07/30/creative-wedding-floor-wrap-designs/?$ /blog/creative-wedding-floor-wrap-designs [R=301,L]

# ---------------------------------------------------------------------------
# 7. RETIRED WORDPRESS ARCHIVE PAGINATION
# ---------------------------------------------------------------------------
RewriteRule ^category/blog/page/[0-9]+/?$ /blog [R=301,L]
RewriteRule ^category/.*$ /blog [R=301,L]
RewriteRule ^tag/.*$ /blog [R=301,L]
RewriteRule ^blog/page/[0-9]+/?$ /blog [R=301,L]
RewriteRule ^pages/?$ / [R=301,L]
RewriteRule ^media/?$ / [R=301,L]

# ---------------------------------------------------------------------------
# 7a. OLD DATE URLS -> /blog/<slug>
#     Posts moved from /YYYY/MM/DD/<slug> to /blog/<slug>. The specific rules
#     above already send renamed/drifted URLs straight to /blog/ in one hop;
#     this catches every other date URL. /blog/ (slash) -> /blog.
# ---------------------------------------------------------------------------
RewriteRule ^[0-9]{4}/[0-9]{2}/[0-9]{2}/([^/]+)/?$ /blog/$1 [R=301,L]
RewriteRule ^blog/$ /blog [R=301,L]

# ---------------------------------------------------------------------------
# 7b. TRAILING-SLASH CANONICALISATION
#     Placed AFTER the redirect rules on purpose: those already match /?$ and
#     resolve a slashed legacy URL in ONE hop. Putting a global strip earlier
#     would add a hop to every one of them and breach the 2-hop gate.
#     Without this, every canonical URL serves 200 at both /x and /x/.
# ---------------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# ---------------------------------------------------------------------------
# 8. PRERENDERED ROUTE LOOKUP  (inactive until dist/<route>.html files exist)
#    Must sit AFTER redirects and BEFORE the SPA fallback.
# ---------------------------------------------------------------------------
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ /$1.html [L]

# ---------------------------------------------------------------------------
# 9. REACT SPA FALLBACK — MUST BE LAST
#
# !! CHANGE THESE TWO LINES IN THE SAME DEPLOY AS THE FIRST PRERENDER BUILD !!
# Once scripts/prerender.mjs runs, dist/index.html IS the prerendered homepage.
# If this fallback still points at it, every unknown URL serves homepage content
# with a 200 — recreating the soft 404s. The build writes dist/app-shell.html
# (the untouched shell) and dist/404.html for exactly this purpose.
# Do NOT switch early: app-shell.html does not exist until that build runs.
#
#   ErrorDocument 404 /404.html
#   RewriteRule . /app-shell.html [L]
# ---------------------------------------------------------------------------
# Switched 23 Oct 2026, shipped together with the first prerender build.
ErrorDocument 404 /404.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /app-shell.html [L]
