# ---------------------------------------------------------------------------
# 7. RETIRED WORDPRESS ARCHIVE PAGINATION
# ---------------------------------------------------------------------------
RewriteRule ^category/blog/page/[0-9]+/?$ /blog [R=301,L]
RewriteRule ^category/.*$ /blog [R=301,L]

# ---------------------------------------------------------------------------
# 7b. TRAILING-SLASH CANONICALISATION
#     Placed AFTER the redirect rules on purpose: those already match /?$ and
#     resolve a slashed legacy URL in ONE hop. Putting a global strip earlier
#     would add a hop to every one of them and breach the 2-hop gate.
#     Without this, every canonical URL serves 200 at both /x and /x/.
# ---------------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# ---------------------------------------------------------------------------
# 8. PRERENDERED ROUTE LOOKUP  (inactive until dist/<route>.html files exist)
#    Must sit AFTER redirects and BEFORE the SPA fallback.
# ---------------------------------------------------------------------------
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ /$1.html [L]

# ---------------------------------------------------------------------------
# 9. REACT SPA FALLBACK — MUST BE LAST
# ---------------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
