DirectoryIndex index.html index.php

RewriteEngine On
RewriteBase /

# ---------------------------------------------------------------------------
# 1. QUERY-STRING CLEANUP  (was: blanket redirect to YouTube)
#    Strips AMP / noamp / et_blog and keeps the visitor on elegantize.com.
#    Matches bare and valued forms: ?amp  ?amp=1  ?amp=0  ?noamp  ?noamp=mobile
#    ?noamp=available  ?et_blog  ?et_blog=1 — but NOT ?et_blogger=1 / ?amphora=3.
#    Absolute target avoids depending on ServerName/UseCanonicalName.
# ---------------------------------------------------------------------------
RewriteCond %{QUERY_STRING} (^|&)(amp|noamp|et_blog)(=[^&]*)?(&|$) [NC]
RewriteRule ^(.*?)/?$ https://elegantize.com/$1 [R=301,L,QSD]

# ---------------------------------------------------------------------------
# 2. MALFORMED PATHS  (retained — narrow, known-bad link shapes)
# ---------------------------------------------------------------------------
RewriteRule ^.*www\.youtube\.com/@elegantize.*$ https://www.youtube.com/@elegantize [R=301,NC,L]
RewriteRule ^.*https:/elegantize\.com.*$ https://www.youtube.com/@elegantize [R=301,NC,L]

# Feed URLs are content requests, not video requests.
RewriteRule ^(.+/)?feed/?$ /blog [R=301,L]

# ---------------------------------------------------------------------------
# 3. DUPLICATE SLUG PAGES
# ---------------------------------------------------------------------------
RewriteRule ^home-4/?$ / [R=301,L]
RewriteRule ^home/?$ / [R=301,L]
RewriteRule ^about-us/?$ /about [R=301,L]
RewriteRule ^blog-2/?$ /blog [R=301,L]
RewriteRule ^floral-design-3/?$ /services/floral-design [R=301,L]
RewriteRule ^ceiling-design-2/?$ /services/ceiling-design [R=301,L]
RewriteRule ^centerpiece-design-3/?$ /services/centerpiece-design [R=301,L]
RewriteRule ^vinyl-floor-wraps-3/?$ /services/vinyl-floor-wrap [R=301,L]
RewriteRule ^draping-services-2/?$ /services/draping-services [R=301,L]

# ---------------------------------------------------------------------------
# 4. LEGACY SERVICE SLUGS -> /services/*
# ---------------------------------------------------------------------------
RewriteRule ^ceiling-design/?$ /services/ceiling-design [R=301,L]
RewriteRule ^floral-design/?$ /services/floral-design [R=301,L]
RewriteRule ^centerpiece-design/?$ /services/centerpiece-design [R=301,L]
